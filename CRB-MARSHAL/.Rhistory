dataset2 <- data.frame("Sire" = kronecker(c(1, 2, 3), c(1, 1, 1, 1)),
"Dam" = kronecker(c(1, 2, 1, 2, 1, 2), c(1, 1)),
"ADG" = c(2.24, 1.85, 2.05, 2.41, 1.99, 1.93,
2.72, 2.32, 2.33, 2.68, 2.69, 2.71))
dataset2$Sire<-as.factor(dataset2$Sire)
dataset2$Dam<-as.factor(dataset2$Dam)
mod_lm<-stats::lm(ADG ~ Sire/Dam, dataset2)
summary(mod_lm)
stats::anova(mod_lm)
require(lme4)
mod_lmer<-lme4::lmer(ADG ~ 1 + (1|Sire) + (1|Dam:Sire), dataset2)
summary(mod_lmer)
getME(mod_lmer, "Z")
getME(mod_lmer, "Lambda") * sigma(mod_lmer)) ** 2
(getME(mod_lmer, "Lambda") * sigma(mod_lmer)) ** 2
##
pander((getME(mod_lmer, "Lambda") * sigma(mod_lmer)) ** 2)
# Affichage des matrices :
## Matrice Z
getME(mod_lmer, "Z")
##
(getME(mod_lmer, "Lambda") * sigma(mod_lmer)) ** 2
getME(mod_lmer, "Z")
(getME(mod_lmer, "Lambda") * sigma(mod_lmer)) ** 2
emmeans(mod_lmer, ~1)
lmerTest::ranova(mod_lmer)
