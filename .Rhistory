age_i <- 60
cat("================= \n")
cat("Age = ", age_i, "\n")
cat("================= \n")
temp_df <- Macro_full %>% filter(age == age_i)
temp_lm <- lm(temp_df, formula = Krs ~ Scenario_ID)
# plot(temp_lm)
pander(summary(temp_lm))
print(emmeans(temp_lm, ~Scenario_ID))
# anova(temp_lm)
data2stat   <- Macro_full %>%
filter(age >= 20)
# CHECK NORMALITY
par(mfrow = c(1, 2))
qqnorm(data2stat$Krs)
qqline(data2stat$Krs)
hist(data2stat$Krs)
shapiro.test(data2stat$Krs)
# NORMALIZE WITH BOX-COX
bc         <- MASS::boxcox(lm(data2stat$Krs ~ 1))
lambda_Krs <- bc$x[which(bc$y == max(bc$y))]
data2stat$Krs_tf <- BoxCox(data2stat$Krs, lambda_Krs)
# data2stat$kr_tf <- log(sqrt(data2stat$kr))
# CHECK NORMALITY
par(mfrow = c(1, 2))
qqnorm(data2stat$Krs_tf)
qqline(data2stat$Krs_tf)
hist(data2stat$Krs_tf)
shapiro.test(data2stat$Krs_tf)
# BUILD LM
Krs_lm_full1 <- lm(data = data2stat,
formula = Krs ~ Scenario_ID + age + age:Scenario_ID
)
par(mfrow = c(2,2))
plot(Krs_lm_full1)[1]
summary(Krs_lm_full1)
# PREDICT AND PLOT
data2stat$Krs_pred <- predict(Krs_lm_full1, data2stat)
p1 <- ggplot(data2stat) +
geom_point(aes(x = age,
y = Krs,
color = Scenario_ID),
position = position_dodge(4)
) +
geom_line(aes(x = age,
y = Krs_pred,
color = Scenario_ID),
# shape = 2,
position = position_dodge(4)) +
# geom_smooth(method = "lm") +
scale_color_manual(values = S_colors)+
theme_few()
p1
Krs_lm_full2 <- lm(data = data2stat,
formula = Krs_tf ~ Scenario_ID + age + age:Scenario_ID)
par(mfrow = c(2,2))
plot(Krs_lm_full2)[1]
summary(Krs_lm_full2)
data2stat$Krs_tf_pred    <- predict(Krs_lm_full2, data2stat)
p2 <- ggplot(data2stat) +
geom_point(aes(x = age,
y = BoxCox_reverse(Krs_tf, lambda_Krs),
color = Scenario_ID),
position = position_dodge(4)
) +
geom_line(aes(x = age,
y = BoxCox_reverse(Krs_tf_pred, lambda_Krs),
color = Scenario_ID),
# shape = 2,
position = position_dodge(4)) +
xlab("Age [d]") +
ylab(expr(K[rs] ~ "[" ~ m^{3} ~ MPa^{-1} ~ s^{-1} ~ "]"))     +
scale_color_manual(values = S_colors)+
theme_few()
grid.arrange(p1, p2)
svg(filename = "./plots/CRB-MARSHAL/Krs_LM_predict.svg", width = 5, height = 4)
p2
dev.off()
for(age_i in unique(SUF_df2$age[order(SUF_df2$age)])){
cat("================= \n")
cat("Age = ", age_i, "\n")
cat("================= \n")
temp_SUF   <- SUF_df2 %>% filter(age == age_i)
p <- ggplot(temp_SUF) +
geom_point(aes(x = zr, y = SUF_sum_mean, color = Scenario_ID)) +
geom_line(aes(x = zr, y = SUF_sum_mean, color = Scenario_ID))
plot(p)
distrib_WT     <- temp_SUF$SUF_sum_mean[temp_SUF$Scenario_ID == "WT"]
distrib_kAQP   <- temp_SUF$SUF_sum_mean[temp_SUF$Scenario_ID == "kAQP"]
distrib_2      <- temp_SUF$SUF_sum_mean[temp_SUF$Scenario_ID == "Sub"]
distrib_SubSG  <- temp_SUF$SUF_sum_mean[temp_SUF$Scenario_ID == "SubSG"]
# plot(distrib_WT)
# plot(distrib_SubSG)
ks_test    <- ks.test(distrib_WT, distrib_SubSG)
print(ks_test)
}
