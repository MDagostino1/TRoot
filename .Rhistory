kAQP_value <- unique(Data_Full$kAQP)[5]
Data_EB <- data.frame()
for(i in unique(Conductivities_processed$x)){
temp_cdt <- Conductivities_processed %>% filter(x == i & kAQP==kAQP_value)
for(j in unique(temp_cdt$Barrier_Name)){
cat("x = ", i, " | Barrier_Name = ", j, "\n")
temp_df <- data.frame(x = i,
Barrier_Name = j,
kr_mean = mean(temp_cdt$kr[temp_cdt$Barrier_Name == j]),
kr_sd = sd(temp_cdt$kr[temp_cdt$Barrier_Name == j]),
kr_median = median(temp_cdt$kr[temp_cdt$Barrier_Name == j]),
kr_mad = mad(temp_cdt$kr[temp_cdt$Barrier_Name == j]),
Kx_mean = mean(temp_cdt$Kx[temp_cdt$Barrier_Name == j]),
Kx_sd = sd(temp_cdt$Kx[temp_cdt$Barrier_Name == j]),
Kx_median = median(temp_cdt$Kx[temp_cdt$Barrier_Name == j]),
Kx_mad = mad(temp_cdt$Kx[temp_cdt$Barrier_Name == j]),
Kr_mean = mean(temp_cdt$Kr[temp_cdt$Barrier_Name == j]),
Kr_sd = sd(temp_cdt$Kr[temp_cdt$Barrier_Name == j]),
Kr_median = median(temp_cdt$Kr[temp_cdt$Barrier_Name == j]),
Kr_mad = mad(temp_cdt$Kr[temp_cdt$Barrier_Name == j]))
Data_EB <- rbind(Data_EB, temp_df)
}
}
