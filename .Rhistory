# kr vs kAQP
kAQP_plot1 <- ggplot(data = Conductivities_dico,
aes(x=(kAQP*10000),
y = kr*1e08,
color = Barrier))+
geom_point(aes(x = as.factor(kAQP*10000)),
position = "jitter",
alpha = 0.05) +
# geom_boxplot(aes(x = as.factor(kAQP*10000), y = kr, color = Barrier))+
# facet_wrap(~Barrier) +
# scale_color_viridis() +
geom_smooth(linewidth = 2) +
ylab(expression(k[r] ~ 10^{8} ~ "[" * m ~ MPa^{-1} ~ s^{-1}*"]")) +
# xlab("kAQP [10e-04 cm hPA-1 d-1]") +
xlab(expression(kAQP ~ 10^{-4} ~ "[" * cm ~ hPa^{-1} ~ d^{-1} * "]")) +
ylim(2, 12) +
theme_test()
