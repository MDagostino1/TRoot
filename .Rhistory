y     = Krs_mean,
color = Scenario_ID
),
position = position_dodge(width = PD),
alpha = 1) +
geom_line(aes(x     = age,
y     = Krs_mean,
color = Scenario_ID
),
position = position_dodge(width = PD),
alpha = 1) +
geom_errorbar(aes(x = age,
ymin = Krs_mean - Krs_sd,
ymax = Krs_mean + Krs_sd,
color = Scenario_ID),
position = position_dodge(width = PD),
width = 1
) +
scale_fill_manual(values = S_colors) +
scale_color_manual(values = S_colors) +
xlab("Age [d]") +
ylab(expr(K[rs] ~ "[" ~ m^{3} ~ MPa^{-1} ~ s^{-1} ~ "]"))     +
theme_few()
p2
svg(filename = paste0(path.plots, "Krs_full_2.svg"),
width = 4, height = 2)
p2
dev.off()
