theme_classic()
ggplot(Macro_full) +
geom_boxplot(aes(x = as.factor(age), y = Krs)) +
facet_wrap(~Scenario_ID)
ggplot(Macro_full) +
geom_point(aes(x = as.factor(age), y = Krs, group = Sim_ID, color = Scenario_ID)) +
geom_line(aes(x = as.factor(age), y = Krs, group = Sim_ID, color = Scenario_ID), alpha = 1) +
# geom_boxplot(aes(x = as.factor(age), y = Krs, fill = Scenario_ID)) +
theme_classic()
ggplot(Macro_full) +
geom_boxplot(aes(x = as.factor(age), y = Krs)) +
facet_wrap(~Scenario_ID)
ggplot(Macro_full) +
geom_point(aes(x = as.factor(age), y = Krs, group = Sim_ID, color = Scenario_ID)) +
geom_line(aes(x = as.factor(age), y = Krs, group = Sim_ID, color = Scenario_ID), alpha = 1) +
# geom_boxplot(aes(x = as.factor(age), y = Krs, fill = Scenario_ID)) +
xlab("Age [d]") +
ylab("Krs") +
theme_classic()
