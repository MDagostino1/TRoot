# ==============================================================================
# Stele SD

stele_SD <- function(x){

  if(x <= 25){
    y <- 1.622e-05  *x + 1.078e-03 + rnorm(1, mean = 0, sd = 0.0002994)
  }else{
    y <- exp(0.29097*x + -14.01093 + rnorm(1, mean = 0, sd = 0.317))
  }

  return(y)
}

# ==============================================================================
# Phloem N Layers

phloem_n_layers <- function(x){

  if(x < 7.41){
    y <- 0.
  } else{
    y <- round(exp(0.11923*x + -1.995 + rnorm(1, mean = 0, sd = 0.35)))
    #Quality check : phloem must be >= 1 in SG
    if(y == 0){
      y = 1
    }
  }

  return(y)
}

