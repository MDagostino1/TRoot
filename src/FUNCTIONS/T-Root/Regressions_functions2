# Xylem Cell Diameter

xylem_cell_diameter <- function(x){

  y <- abs(0.001215*x + 0.01228 + rnorm(1, mean = 0, sd = 0.0041))

  return(y)
}

# ==============================================================================
# Stele Layer Diameter

stele_layer_diameter <- function(x){

  if(x <= 25){
    y <- 0.0031*x + 0.12112 + rnorm(1, mean = 0, sd = 0.02149)
  }else{
    y <- exp(0.19943*x + -6.43122 + rnorm(1, mean = 0, sd = 0.35103))
  }

  return(y)
}

# ==============================================================================
# Stele cell diameter

stele_cell_diameter <- function(x){

  if(x <= 25){
    y <- 0.00012*x + 0.0073 + rnorm(1, mean = 0, sd = 0.00071)
  }else{
    y <- 0.00166*x + -0.02994 + rnorm(1, mean = 0, sd = 0.00382)
  }

  return(y)
}

