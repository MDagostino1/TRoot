marshal_monocot <- function(RS_1_mono, 
                            RS_1_mono_conductivities, 
                            psiCollar = -15000,
                            soil = data.frame(id = c(1,2,3,4),
                                              z = c(0, -40, -80, -120),
                                              psi = c(-15000, -300, -300, -300))){
  
  # Change radius
  RS_1_mono$radius <- 0.1889
  
  p2 <- ggplot(data = RS_1_mono, aes(color = type)) + 
    # geom_point(aes(x = x1, y = z1)) +
    geom_segment(aes(x = x1, y = z1, xend = x2, yend = z2), linewidth = 2) +
    xlim(-10, 10) +
    # scale_color_brewer(palette = "Set2") +
    # scale_color_viridis() +
    theme_bw()
  
  # svg(filename = "Plots/Root_System1.svg", height = 10)
  p2
  # dev.off()
  
  # Correct nodes
  # We go through the banchID
  suppressWarnings({
    for(i in unique(RS_1_mono$branchID)[-1]){
      
      RS_1_mono$node1ID[RS_1_mono$branchID == i][-1] <- which(RS_1_mono$branchID == i)[-length(which(RS_1_mono$branchID == 1))]
      
      if(RS_1_mono$type[RS_1_mono$branchID == i][1] == 2){ # connection with the parental root
        x1_child <- RS_1_mono$x1[RS_1_mono$branchID == i][1]
        y1_child <- RS_1_mono$y1[RS_1_mono$branchID == i][1]
        z1_child <- RS_1_mono$z1[RS_1_mono$branchID == i][1]
        
        tmp_time <- RS_1_mono$time[RS_1_mono$branchID == i][1]
        
        nearest <- RS_1_mono%>%filter(branchID != i)%>%
          mutate(euc = sqrt((x1-x1_child)^2+ (y1 - y1_child)^2 + (z1 - z1_child)^2))
        nearest <- nearest[nearest$euc == min(nearest$euc), ]
        RS_1_mono$node1ID[RS_1_mono$branchID == i][1] <- nearest$node2ID[1] # oldest segments
      }
    }  
  })
  
  
  #======================
  # ADD CONDUCTIVITIES
  #======================
  
  # RS_1_mono$kr <- NULL
  # RS_1_mono$kx <- NULL
  
  # Main Root kr
  for (z_i in RS_1_mono$z1[RS_1_mono$type == 1]) {
    RS_1_mono$kr[RS_1_mono$type == 1 & RS_1_mono$z1 == z_i] <- radial_reg(abs(min(RS_1_mono$z1[RS_1_mono$type == 1])-z_i))
    RS_1_mono$kx[RS_1_mono$type == 1 & RS_1_mono$z1 == z_i] <- axial_reg(abs(min(RS_1_mono$z1[RS_1_mono$type == 1])-z_i))
  }

  # Lateral Roots kr
  for(b_i in unique(RS_1_mono$branchID)){
    temp_root <- RS_1_mono %>% filter(branchID == b_i)
    for (z_i in temp_root$z1) {
      temp_root$kr[temp_root$z1 == z_i] <- radial_reg2(abs(min(temp_root$z1)-z_i))
      # temp_root$kx[temp_root$z1 == z_i] <- axial_reg2(abs(min(temp_root$z1)-z_i))
      temp_root$kx[temp_root$z1 == z_i] <- 0.033
    }
    RS_1_mono$kr[RS_1_mono$branchID == b_i] = temp_root$kr
    RS_1_mono$kx[RS_1_mono$branchID == b_i] = temp_root$kx
  }

  
  # PLot
  p2 <- ggplot(data = RS_1_mono, aes(color = kr)) + 
    # geom_point(aes(x = x1, y = z1)) +
    geom_segment(aes(x = x1, y = z1, xend = x2, yend = z2)) +
    xlim(-10, 10) + 
    # scale_color_viridis() +
    # facet_wrap(~type) +
    theme_bw()
  
  p3 <- ggplot(data = RS_1_mono, aes(color = kx)) + 
    # geom_point(aes(x = x1, y = z1)) +
    geom_segment(aes(x = x1, y = z1, xend = x2, yend = z2)) +
    xlim(-10, 10) + 
    scale_color_viridis() +
    # facet_wrap(~type) +
    theme_bw()
  
  # svg(filename = "Plots/Root_System2.svg", height = 10)
  p2
  # dev.off()
  
  # svg(filename = "Plots/Root_System3.svg", height = 10)
  p3
  # dev.off()
  
  # Set up conductivities
  for (id in RS_1_mono_conductivities$id) {
    if (RS_1_mono_conductivities$type[RS_1_mono_conductivities$id == id] == "kr"){
      # RS_1_mono_conductivities$y[RS_1_mono_conductivities$id == id] = radial_reg2(RS_1_mono_conductivities$x[RS_1_mono_conductivities$id == id])
      RS_1_mono_conductivities$y[RS_1_mono_conductivities$id == id] = 5e-08
    }
    else if (RS_1_mono_conductivities$type[RS_1_mono_conductivities$id == id] == "kx"){
      # RS_1_mono_conductivities$y[RS_1_mono_conductivities$id == id] = axial_reg2(RS_1_mono_conductivities$x[RS_1_mono_conductivities$id == id])
      RS_1_mono_conductivities$y[RS_1_mono_conductivities$id == id] = 1e-08
      }
  }  
  
  # DEFAULT PARAMETERS & VARIABLES
  # psiCollar <- -15000
  # psiCollar_vec <- c(-15000)
  # soil <- read_csv(paste0(MPath,"inputs/soil.csv"))
  
  # psi_collar :
  # soil$psi[soil$z != 0] = -14999

  # ======================================================
  current_rootsystem <- RS_1_mono
  # ======================================================
  
  # Run MARSHAL
  conds2 <- RS_1_mono_conductivities
  hydraulics2 <- getSUF(current_rootsystem, conds2, soil, psiCollar, hetero = F)
  
  # Update results into hydraulic architecture 
  hydraulic_archi2 <- current_rootsystem
  hydraulic_archi2$suf <- hydraulics2$suf[,1]
  hydraulic_archi2$kr <- hydraulics2$kr[,1]
  hydraulic_archi2$kx <- hydraulics2$kx[,1]
  hydraulic_archi2$jr <- hydraulics2$jr[,1]
  hydraulic_archi2$jxl <- hydraulics2$jxl[,1]
  hydraulic_archi2$psi <- hydraulics2$psi
  
  print(paste0("Krs : ", hydraulics2$krs))
  print("==================================================================")
  
  # Save only the relevant results of the simulation data in a new dataframe. 
  # all_marshal2 <- tibble("kx" = kx_in,
  #                        "kr" = kr_in,
  #                        "length" = sum(current_rootsystem$length),
  #                        "transpiration" = hydraulics2$tact,
  #                        "krs" = hydraulics2$krs)
  
  # Export all the results of the simulation
  return(hydraulic_archi2)
}
