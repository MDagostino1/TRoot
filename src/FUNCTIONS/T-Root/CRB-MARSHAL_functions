MARSHAL_LOOP <- function(RS_path, scenario){
  # Runs MARSHAL for all RS files in csv format present in RS_path file
  # For different scenarios :
  # - S1 : Tomato ; LC in exo, SUB exo, SUB endo at 25 days, SG at 25 days
  # - S2 : No LC and no SUB in exo ; SUB endo at 25 days; SG at 25 days
  # - S2b : same that S2 but sub ENDO at 7 days
  # - S3 : No LC and no SUB in EXO ; SUB in ENDO at 25 days ; no SG
  # - S4 : No LC but SUB in EXO ; SUB in endo at 25 days ; SG at 25 days
  
  RSHA_table <- tibble()
  Krs_table <- tibble()
  
  for(RS_i in list.files(RS_path, pattern = ".csv")){
    
    # print(RS_i)
    
    RS_i_name <- strsplit(RS_i, split = ".csv")[[1]]
    
    RS <- read.csv(paste0(RS_path, RS_i))
    
    # ==========================================================================
    # SCENRAIO 1
    if(scenario == "S1"){
      RS$time2 <- max(RS$time) - RS$time
      RS$radius[RS$type == 1] <- radius_reg(x = abs(RS$time2[RS$type == 1]), 
                                                  timing = c(7, 25))
      RS$radius[RS$type == 2] <- radius_reg(x = abs(RS$time2[RS$type == 2]), 
                                                  timing = c(7, 25))
      
      RSHA <- marshal_tomato(RS, 
                              dico_conductivities, 
                              Timing_kr = c(7, 25),
                              # Timing_Kx = c(7, 20),
                              kr_coef = kr_coef, 
                              kx_coef = kx_coef,
                              psiCollar = psi_Collar,
                              soil = my_soil)
    }
    
    # ==========================================================================
    # SCENRAIO 2
    if(scenario == "S2"){
      RS$time2 <- max(RS$time) - RS$time
      RS$radius[RS$type == 1] <- radius_reg(x = abs(RS$time2[RS$type == 1]), 
                                                  timing = c(7, 25))
      RS$radius[RS$type == 2] <- radius_reg(x = abs(RS$time2[RS$type == 2]), 
                                                  timing = c(7, 25))
      
      RSHA <- marshal_tomato(RS, 
                              dico_conductivities, 
                              Timing_kr = c(25,26),
                              Timing_Kx = c(7,25),
                              kr_coef = kr_coef_mono, 
                              kx_coef = kx_coef,
                              psiCollar = psi_Collar,
                              soil = my_soil)
    }
    
    # ==========================================================================
    # SCENARIO 2bis
    if(scenario == "S2b"){
      RS$time2 <- max(RS$time) - RS$time
      RS$radius[RS$type == 1] <- radius_reg(x = abs(RS$time2[RS$type == 1]), 
                                                    timing = c(7, 25))
      RS$radius[RS$type == 2] <- radius_reg(x = abs(RS$time2[RS$type == 2]), 
                                                    timing = c(7, 25))
      
      RSHA <- marshal_tomato(RS, 
                               dico_conductivities, 
                               Timing_kr = c(7,25),
                               Timing_Kx = c(7,25),
                               kr_coef = kr_coef_mono, 
                               kx_coef = kx_coef,
                               psiCollar = psi_Collar,
                               soil = my_soil)
    }
    
    # ==========================================================================
    # SCENRAIO 3
    if(scenario == "S3"){
      RS$time2 <- max(RS$time) - RS$time
      RS$radius[RS$type == 1] <- 0.18
      RS$radius[RS$type == 2] <- 0.18
      
      RSHA <- marshal_tomato(RS, 
                              dico_conductivities, 
                              Timing_kr = c(7, 25),
                              Timing_Kx = c(7, 50), # /!\
                              kr_coef = kr_coef, 
                              kx_coef = kx_coef,
                              psiCollar = psi_Collar,
                              soil = my_soil)
    }
    
    # ==========================================================================
    # SCENARIO 4
    if(scenario == "S4"){
      RS$time2 <- max(RS$time) - RS$time
      RS$radius[RS$type == 1] <- radius_reg(x = abs(RS$time2[RS$type == 1]), 
                                                  timing = c(7, 25))
      RS$radius[RS$type == 2] <- radius_reg(x = abs(RS$time2[RS$type == 2]), 
