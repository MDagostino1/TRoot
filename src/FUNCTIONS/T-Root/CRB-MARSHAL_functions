
marshal_tomato <- function(RS_1_dico, 
                           dico_conductivities, 
                           Timing_kr = c(7, 25),
                           Timing_Kx = c(7, 25),
                           kr_coef, 
                           kx_coef,
                           psiCollar = -15000,
                           soil = data.frame(id = c(1,2,3,4),
                                             z = c(0, -40, -80, -120),
                                             psi = c(-15000, -300, -300, -300))){
  
  # Set radius for laterals : 0.18 is the mean value for x < 25
  # RS_1_dico$radius[RS_1_dico$type == 2] <- 0.18
  RS_1_dico$type <- as.factor(RS_1_dico$type)
  
  p1 <- ggplot(data = RS_1_dico, aes(color = time, size = radius)) + 
    # geom_point(aes(x = x1, y = z1)) +
    geom_segment(aes(x = x1, y = z1, xend = x2, yend = z2)) +
    xlim(-10, 10) +
    # scale_color_brewer(palette = "Set2") +
    # scale_color_viridis_d() +
    theme_bw()
  
  # svg(filename = "Plots/Root_System1.svg", height = 10)
  p1
  # dev.off()
  
  #===============================================================================
  # Correct the branching
  #===============================================================================
  
  # We go through the banchID
  suppressWarnings({
    for(i in unique(RS_1_dico$branchID)[-1]){
      RS_1_dico$node1ID[RS_1_dico$branchID == i][-1] <- which(RS_1_dico$branchID == i)[-length(which(RS_1_dico$branchID == 1))]
      if(RS_1_dico$type[RS_1_dico$branchID == i][1] == 2){ # connection with the parental root
        x1_child <- RS_1_dico$x1[RS_1_dico$branchID == i][1]
        y1_child <- RS_1_dico$y1[RS_1_dico$branchID == i][1]
        z1_child <- RS_1_dico$z1[RS_1_dico$branchID == i][1]

        tmp_time <- RS_1_dico$time[RS_1_dico$branchID == i][1]
        
        nearest <- RS_1_dico%>%filter(branchID != i)%>%
          mutate(euc = sqrt((x1-x1_child)^2+ (y1 - y1_child)^2 + (z1 - z1_child)^2))
        nearest <- nearest[nearest$euc == min(nearest$euc), ]
        RS_1_dico$node1ID[RS_1_dico$branchID == i][1] <- nearest$node2ID[1] # oldest segments
      }
    }  
  })
  
  #===============================================================================
  # Set conductivities
  #===============================================================================
  
  # Change conductivities in RS_conducts
  # /!\ MARSHAL units are in cm d-1 HPa-1 where my units are m s-1 MPa-1 -> need for conversion
  for (id in dico_conductivities$id) {
    # print(id)
    # print(dico_conductivities$type[dico_conductivities$id == id])
    
    # Kr main root
    if (dico_conductivities$type[dico_conductivities$id == id] == "kr" & dico_conductivities$order_id[dico_conductivities$id == id] == 1){
      dico_conductivities$y[dico_conductivities$id == id] = radial_reg(x = dico_conductivities$x[dico_conductivities$id == id], 
                                                                       timing = Timing_kr,
                                                                       coefficients  = kr_coef)*864
    }
    
    # Kr lateral
    else if(dico_conductivities$type[dico_conductivities$id == id] == "kr" & dico_conductivities$order_id[dico_conductivities$id == id] == 2){
      # dico_conductivities$y[dico_conductivities$id == id] = 7.5e-08
      dico_conductivities$y[dico_conductivities$id == id] = radial_reg(x = dico_conductivities$x[dico_conductivities$id == id], 
                                                                       timing = Timing_kr,
                                                                       coefficients  = kr_coef)*864
    }
      
    # Kx main root
    else if (dico_conductivities$type[dico_conductivities$id == id] == "kx" & dico_conductivities$order_id[dico_conductivities$id == id] == 1){
      dico_conductivities$y[dico_conductivities$id == id ] = axial_reg(x = dico_conductivities$x[dico_conductivities$id == id],
                                                                       timing = Timing_Kx,
                                                                       coefficients = kx_coef)*8640000
    }
    
    #Kx lateral
    else if (dico_conductivities$type[dico_conductivities$id == id] == "kx" & dico_conductivities$order_id[dico_conductivities$id == id] == 2){
      # dico_conductivities$y[dico_conductivities$id == id] = 0.05
      dico_conductivities$y[dico_conductivities$id == id ] = axial_reg(x = dico_conductivities$x[dico_conductivities$id == id],
                                                                       timing = Timing_Kx,
                                                                       coefficients = kx_coef)*8640000
    }
  }
  
  #===============================================================================
  #Set up MARSHAL
  #===============================================================================
  kx_vec = 1
  kr_vec = 1
  all_marshal <- NULL
  tot_marshal_sim <- length(kr_vec) * length(kx_vec)
  stock1 <- list()   # va stocker tous les outputs
  stock2 <- list()
  plot_list <- list() # stocke les plots
  RMS_df <- data.frame(kr = c(), kx = c(), krs = c(), RMS = c())
  current_rootsystem <- RS_1_dico
  #=============================================================================
  #=============================================================================
  
  # RUN MARSHAL
  hydraulic_temp <- getSUF(current_rootsystem, table_cond = dico_conductivities, soil, psiCollar, hetero = F)
  
  #=============================================================================
  #=============================================================================
    # Update results into hydraulic architecture 
  hydraulic_archi_temp <- current_rootsystem
  hydraulic_archi_temp$suf <- hydraulic_temp$suf[,1]
  hydraulic_archi_temp$kr <- hydraulic_temp$kr[,1]
  hydraulic_archi_temp$kx <- hydraulic_temp$kx[,1]
  hydraulic_archi_temp$jr <- hydraulic_temp$jr[,1]
  hydraulic_archi_temp$jxl <- hydraulic_temp$jxl[,1]
  hydraulic_archi_temp$psi <- hydraulic_temp$psi
  # print(paste0("Krs : ", hydraulic_temp$krs/864000, " m3 s-1 MPa-1"))
  # print("==================================================================")
  # Save only the relevant results of the simulation data in a new dataframe. 
  all_marshal2 <- tibble("length" = sum(current_rootsystem$length),
                         "transpiration" = hydraulic_temp$tact,
                         "krs" = hydraulic_temp$krs/864000)
  # Export all the results of the simulation
  # write.csv(hydraulic_archi_temp, file = paste0("CRB-MARSHAL/outputs/HA_", Sys.Date(),"_",n_marshal_sim, ".csv"))
  # write.csv(all_marshal2, file = paste0("CRB-MARSHAL/outputs/All_Marshal_", Sys.Date(),"_",n_marshal_sim, ".csv"))
  return(list(hydraulic_archi_temp, hydraulic_temp$krs))
  
}
