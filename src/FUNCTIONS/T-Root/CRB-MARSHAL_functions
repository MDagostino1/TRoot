                              Timing_Kx = c(7,25),
                              kr_coef = kr_coef, 
                              kx_coef = kx_coef,
                              psiCollar = psi_Collar,
                              soil = my_soil)
    }
    
    # ==========================================================================
    # EXPORT RESULTS
    RSHA_i <- RSHA[[1]]
    RSHA_i$RSHA_id <- RS_i_name
    RSHA_table <- rbind(RSHA_table, RSHA_i)
    
    Krs_i <- RSHA[[2]]/864000
    Krs_table <- rbind(Krs_table, tibble(Krs = Krs_i,
                                         RSHA_id = RS_i_name))
    
  }
  
  return(list(RSHA_table, Krs_table))
