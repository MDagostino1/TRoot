  for(x_fac in seq(round(min(full_RSHA$z2[full_RSHA$id == 1])), 0)){
    # Select a subset
    subs <- full_RSHA %>% filter(id == 2 & z2 >= x_fac-0.5 & z2 < x_fac+0.5)
    temp_df <- data.frame(x = x_fac,
                          SUF_mean = sum(subs$suf),
                          SUF_sd = sd(subs$suf))
    suf_df2 <- rbind(suf_df2, temp_df)
  }
  
  suf_df$exp <- 1
  suf_df2$exp <- 2
  combined_data <- rbind(suf_df, suf_df2)
  
  # svg("Plots/SUF_comparaison2.svg", height = 4, width = 6)  
  SUF_bar <- ggplot() +
    geom_bar(data = suf_df, aes(x = x, y = SUF_mean), stat = "identity", fill = "#00AFBB", alpha = 0.5) +
    geom_bar(data = suf_df2, aes(x = x, y = SUF_mean), stat = "identity", fill = "#E7B800", alpha = 0.5) +
    ggtitle("Blue = Tomato | Orange = Monocot") +
    theme_bw()
  # dev.off()
  print(SUF_bar)

  #===============================================================================
  r <- list(Comparative_kr, 
            Comparative_KR, 
            Comparative_Kx,
            Comparative_SUF,
            # Comparative_SUF_main,
            Radius,
            Kr1,
            Kr2,
            Kx1,
            SUF0,
            SUF1,
            SUF2, 
            SUF_bar)
  print("==================================================================")
  return(r)
}

